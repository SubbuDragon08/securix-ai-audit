# Copy to .env and source it, or export these directly.
# .env is gitignored — but note this file only holds client *identifiers*.
# No user credential or refresh token is ever written to disk by this tool.

# --- Microsoft Entra ID -----------------------------------------------------
# Overview page of your app registration in https://entra.microsoft.com
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Google Workspace -------------------------------------------------------
# "Desktop app" OAuth client from https://console.cloud.google.com
# Google does not treat installed-app secrets as confidential:
# https://developers.google.com/identity/protocols/oauth2#installed
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# --- Debugging --------------------------------------------------------------
# AI_AUDIT_LENS_DEBUG=1   # full stack traces on failure
# HTTPS_PROXY=http://proxy.corp.example:8080
# NODE_EXTRA_CA_CERTS=/path/to/corp-root.pem
