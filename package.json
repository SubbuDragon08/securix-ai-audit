{
  "name": "ai-audit-lens",
  "version": "0.1.0",
  "description": "Zero-trust local CLI that pulls Microsoft 365 Copilot and Google Gemini prompt audit logs from your own tenant and renders a single-file HTML dashboard. Nothing leaves the machine.",
  "keywords": [
    "copilot",
    "gemini",
    "audit",
    "purview",
    "microsoft-graph",
    "google-workspace",
    "shadow-ai",
    "compliance"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "bin": {
    "ai-audit-lens": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=build/ai-audit-lens.cjs --legal-comments=none",
    "build:bun": "bun build src/index.ts --compile --minify --target=bun --outfile dist-bin/ai-audit-lens",
    "build:bun:all": "node scripts/build-binaries.mjs",
    "prepublishOnly": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('build',{recursive:true,force:true});require('fs').rmSync('dist-bin',{recursive:true,force:true})\""
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
